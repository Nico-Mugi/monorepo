{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test --concurrency=2",
    "type-check": "turbo type-check",
    "deploy": "turbo deploy",
    "clean": "turbo clean && rimraf node_modules",
    "kill-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-servers.ps1",
    "private:commit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/private-commit.ps1",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
