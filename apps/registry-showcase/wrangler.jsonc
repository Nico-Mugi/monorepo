{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "registry-showcase",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "routes": [
    { "pattern": "registry.playground.nicolas-thouvenin.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "LOGS_DB",
      "database_name": "platform-logs",
      "database_id": "907936d9-7f8b-4647-a87f-4ce708ea7a52"
    }
  ]
}
