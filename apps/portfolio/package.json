{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/compile-cv-pdf-css.mjs && vite dev",
    "build": "npx paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && node scripts/compile-cv-pdf-css.mjs && vite build && tsc --noEmit",
    "preview": "vite preview --port 3001",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "playwright test",
    "test:watch": "playwright test --watch",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist .output .wrangler"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@inlang/paraglide-js-react": "^1.0.2",
    "@repo/ui": "workspace:*",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-start": "^1.167.50",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-tailwind-to-pdf": "workspace:*",
    "shadcn": "^4.5.0",
    "simple-icons": "^16.18.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.1",
    "@inlang/paraglide-js": "^2.18.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-print-to-pdf": "workspace:*",
    "wrangler": "^4.96.0"
  }
}
